# Browser-safe Supabase settings. Never place service-role or database secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set false only when developing against a database older than migration 007.
VITE_SECURE_BACKEND_ENABLED=true

# Optional: Kakao JavaScript SDK key for KakaoTalk report sharing.
# Google/Kakao login providers and redirect URLs are configured in Supabase Auth.
VITE_KAKAO_JS_KEY=your-kakao-javascript-key
